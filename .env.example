# Copia este archivo como .env.local. Nunca subas .env.local al repo.

# Backend: "memory" (datos de prueba, por defecto) o "supabase"
EXPO_PUBLIC_BACKEND=memory

# Solo si EXPO_PUBLIC_BACKEND=supabase (Supabase → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=tu-clave-publishable-o-anon
